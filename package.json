{
  "name": "dsh-goal-budget",
  "version": "0.9.0",
  "description": "Resource budget for DeepSeek Harness goals: attribute token spend to the current goal and block it when a configured budget is exhausted.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "files": [
    "lib",
    "client",
    "locale",
    "src",
    "types",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "THIRD_PARTY"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "goal",
    "budget",
    "cost",
    "quota",
    "guard"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --outfile=lib/index.js --external:@deepseek-ai/*",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types test/loader.spec.ts && node --experimental-strip-types test/budget-command.spec.ts && node --experimental-strip-types test/accounting.spec.ts && node --experimental-strip-types test/projection-view.spec.ts && node --experimental-strip-types test/client-pill.spec.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boom-10/dsh-goal-budget.git"
  },
  "homepage": "https://github.com/boom-10/dsh-goal-budget#readme",
  "bugs": {
    "url": "https://github.com/boom-10/dsh-goal-budget/issues"
  },
  "author": "Jiangdong Chen",
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "zod": "^4.0.0"
  }
}
